<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <runtime>
    <!--
      This process is resident for the length of a game session, which is exactly when the machine
      has the least memory to spare. It never needs more than a few hundred kilobytes of heap, so
      neither a server collector nor a background one is worth the threads and the reserved memory,
      and the collector is told to give committed memory back when the machine runs low.
    -->
    <gcServer enabled="false" />
    <gcConcurrent enabled="false" />
    <gcTrimCommitOnLowMemory enabled="true" />
  </runtime>
</configuration>
