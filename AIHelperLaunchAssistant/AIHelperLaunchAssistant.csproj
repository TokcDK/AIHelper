<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{3F7C1E64-9A2B-4D5E-8C71-0B4D6A9E2F13}</ProjectGuid>
    <OutputType>WinExe</OutputType>
    <RootNamespace>AIHelperLaunchAssistant</RootNamespace>
    <AssemblyName>aihelper-launch-assistant</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <TargetFrameworkProfile />
    <LangVersion>7.3</LangVersion>
    <ApplicationIcon>aihelper-launch-assistant.ico</ApplicationIcon>
    <StartupObject>AIHelperLaunchAssistant.Program</StartupObject>
    <WarningLevel>4</WarningLevel>
    <!--
      The tool is small and has nothing to restore, so there is no reason to let a warning through.
      This is also what keeps it honest about the one rule that matters most here: it must not start
      loading framework assemblies it does not need.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      AnyCPU. Nothing here needs a wider pointer - every handle the tool holds is an IntPtr and every
      structure it declares is sized by Marshal.SizeOf - so one build serves both solution platforms
      and the result is not tied to the machine that produced it. Prefer32Bit is off, so it runs as
      64-bit on a 64-bit system (no WOW64 in the picture) and still runs on a 32-bit one.
    -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <!--
    The tool is gathered in the repository's tools folder, beside the solution, instead of being
    written into a build of the application. postbuild.bat of AI Helper copies it from there into
    RES\tools of the application's output, which is the folder the application reads it from at run
    time, so one build of the tool serves every platform and no build of the application has to
    produce it. Debug and Release share the folder on purpose, exactly as the application's own
    configurations do, so the copy that gets archived is always the one that was built last.
    AssistantToolsDir can be overridden from the command line.
  -->
  <PropertyGroup>
    <AssistantToolsDir Condition=" '$(AssistantToolsDir)' == '' ">$(MSBuildProjectDirectory)\..\tools\aihelper-launch-assistant</AssistantToolsDir>
    <OutputPath>$(AssistantToolsDir)\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\</IntermediateOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <!-- No symbols: this is deployed inside the application folder and only its size matters. -->
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!--
      The base class library and nothing else. No WinForms, no System.Drawing, no logging framework:
      see the remarks on Program and on TrayIcon for why every one of those would be a cost paid for
      as long as a game session lasts.
    -->
    <Reference Include="System" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="ApplicationInfo.cs" />
    <Compile Include="AssistantOutcome.cs" />
    <Compile Include="AssistantUi.cs" />
    <Compile Include="CommandLineParser.cs" />
    <Compile Include="ConsoleBridge.cs" />
    <Compile Include="ExitCodes.cs" />
    <Compile Include="HostApplicationLocator.cs" />
    <Compile Include="HostProgram.cs" />
    <Compile Include="LaunchAssistant.cs" />
    <Compile Include="LaunchOptions.cs" />
    <Compile Include="ParseResult.cs" />
    <Compile Include="ProcessLauncher.cs" />
    <Compile Include="ProcessTarget.cs" />
    <Compile Include="ProcessTree.cs" />
    <Compile Include="ProcessWaiter.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="TargetProgram.cs" />
    <Compile Include="ToolLog.cs" />
    <Compile Include="TrayIcon.cs" />
    <Compile Include="Win32.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <!--
      The command line format, shared with AI Helper. AI Helper writes the line this tool is started
      with and takes apart the line it starts AI Helper with again, so both programs have to apply
      exactly the same quoting rules - see the remarks on the file itself. Linked rather than copied:
      it is one format, and a second copy would be free to drift from the first.
    -->
    <Compile Include="..\Shared\ArgumentQuoting.cs">
      <Link>Shared\ArgumentQuoting.cs</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <None Include="App.config" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="aihelper-launch-assistant.ico" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>