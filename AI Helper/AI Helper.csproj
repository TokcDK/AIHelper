  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <!-- ======================================================================
       Build version, generated automatically.

       The version has the shape <2-digit year>.<month>.<day>.<release number
       of that day>, for example 26.10.13.2, and it is produced on every build.

       The executable already sitting in the output folder is the only record.
       It is the artefact a release is made of, so its version cannot drift away
       from what was actually shipped the way a separate counter file can. There
       is no ledger file.

         Release  the version of the previous build's exe is read. It continues
                  while that build was made today, and restarts at 1 as soon as
                  the day, month or year part changes (25.11.3.4 on the 3rd,
                  then 25.11.4.1 on the 4th). No exe means there is nothing to
                  continue from, so the first release in an empty output folder
                  also starts at <today>.1.
         Debug    the version found in the output folder is used as it stands, so
                  a debug build reports the last release and repeated debug
                  builds stay identical. Nothing is written, so a debug build can
                  never move the counter on. With no exe yet it falls back to
                  0.0.0.0 rather than today's date, so it cannot seed a release
                  number either.

       The counter lives in the exe, so anything that deletes the exe restarts
       the day: "Clean" and "Rebuild" remove it, and the next build then starts
       again at <today>.1 and repacks that name. Use Build while you want the
       counter to continue.

       Properties/AssemblyInfo.cs no longer declares AssemblyVersion or
       AssemblyFileVersion: the target below emits them into
       obj\<Configuration>\VersionInfo.g.cs, or obj\<Platform>\<Configuration>\
       for a platform other than AnyCPU, and that file is compiled in.

       A build can be reproduced for another day with
       -p:AppVersionToday=25.11.4, which is how the day rule is exercised without
       waiting for the date to roll over. The exe the counter is read from can be
       pointed somewhere else with -p:AppVersionPreviousFile=..., which is how
       the rule is tested without touching a real output folder.

       postbuild.bat needs no change. The existing PostBuildMacros target reads
       the version back out of the built assembly and passes it as argument 4,
       so the release archive stays named "name version.7z".
       ====================================================================== -->
  <PropertyGroup>
    <AppVersionDateFormat>yy.M.d</AppVersionDateFormat>
    <AppVersionGeneratedFile>$(IntermediateOutputPath)VersionInfo.g.cs</AppVersionGeneratedFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- Registered for Clean too, so a cleaned build does not leave the file behind. -->
    <FileWrites Include="$(AppVersionGeneratedFile)" />
  </ItemGroup>
  <UsingTask TaskName="ComputeAppVersion" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <PreviousFile ParameterType="System.String" Required="true" />
      <DateFormat ParameterType="System.String" Required="true" />
      <TodayOverride ParameterType="System.String" />
      <Configuration ParameterType="System.String" Required="true" />
      <IsReleaseBuild ParameterType="System.Boolean" Required="true" />
      <AppVersion ParameterType="System.String" Output="true" />
      <AssemblyVersion ParameterType="System.String" Output="true" />
      <PreviousVersion ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Globalization" />
      <Using Namespace="System.IO" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        // Local time: a release is dated by the day the author worked.
        var today = string.IsNullOrEmpty(TodayOverride)
            ? DateTime.Now.ToString(DateFormat, CultureInfo.InvariantCulture)
            : TodayOverride.Trim();
        var prefix = today + ".";

        // The version of the build that produced the exe already sitting in the output folder.
        // That exe is the release, so its version is the only record of where the counter had got
        // to; there is no separate file that could disagree with it.
        var previous = string.Empty;
        if (!string.IsNullOrEmpty(PreviousFile) && File.Exists(PreviousFile))
        {
            try
            {
                var identity = System.Reflection.AssemblyName.GetAssemblyName(PreviousFile);
                if (identity.Version != null) previous = identity.Version.ToString();
            }
            catch (Exception ex)
            {
                // Not a managed assembly, or it cannot be opened. The Win32 version resource is
                // written from AssemblyFileVersion and stays readable even then.
                Log.LogMessage(MessageImportance.Low, "AppVersion: the assembly metadata of '" + PreviousFile
                    + "' could not be read (" + ex.Message + "); trying its version resource.");
                try
                {
                    previous = (System.Diagnostics.FileVersionInfo.GetVersionInfo(PreviousFile).FileVersion ?? string.Empty).Trim();
                }
                catch (Exception inner)
                {
                    Log.LogError("AppVersion: could not read the version of '" + PreviousFile + "': " + inner.Message);
                }
            }

            // An exe that carries no version is not something to guess at: continuing from a made
            // up number could reissue a version that has already been released.
            if (previous.Length == 0 && !Log.HasLoggedErrors)
            {
                Log.LogError("AppVersion: '" + PreviousFile + "' exists but carries no version. Delete it and build again.");
            }
        }

        if (IsReleaseBuild)
        {
            // Continue from the previous build while it was made today; otherwise this is the
            // first release of the day and the counter starts at 1. That one prefix test is what
            // makes the day, month and year boundaries all restart the counter, and the trailing
            // dot is what stops 25.1.3 from matching 25.11.3.7.
            var releaseNumber = 1;
            if (previous.StartsWith(prefix, StringComparison.Ordinal))
            {
                var continued = 0;
                if (int.TryParse(previous.Substring(prefix.Length), NumberStyles.Integer, CultureInfo.InvariantCulture, out continued)
                    && continued >= 0)
                {
                    releaseNumber = continued + 1;
                }
                else
                {
                    Log.LogMessage(MessageImportance.High, "AppVersion: '" + previous
                        + "' is dated today but its release number cannot be read; starting this day at 1.");
                }
            }

            AppVersion = prefix + releaseNumber.ToString(CultureInfo.InvariantCulture);
        }
        else
        {
            // A debug build never moves the counter on: it reports the version already in the
            // output folder, which is the last release, so repeated debug builds stay identical.
            // With no exe there is no release to report, and 0.0.0.0 is used rather than today's
            // date so that a debug build cannot seed a release number either.
            AppVersion = previous.Length > 0 ? previous : "0.0.0.0";
        }

        // The assembly metadata is read back as a System.Version, which drops leading zeroes and
        // rejects anything else, so normalise the value here and fail loudly instead of emitting
        // an attribute the compiler refuses.
        Version parsed;
        if (System.Version.TryParse(AppVersion, out parsed))
        {
            AssemblyVersion = parsed.ToString();
        }
        else
        {
            AssemblyVersion = "0.0.0.0";
            Log.LogError("AppVersion: '" + AppVersion + "' is not a usable version.");
        }

        PreviousVersion = previous;
        Log.LogMessage(MessageImportance.High, "AppVersion: " + AppVersion + " (" + Configuration + ", previous="
            + (previous.Length > 0 ? previous : "<none>") + ")");
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="SetAppVersion" BeforeTargets="CoreCompile" Condition="'$(AppVersionGenerated)' != 'true'">
    <PropertyGroup>
      <!-- Only a configuration whose name starts with "Release" moves the counter on. -->
      <_AppVersionConfiguration>$(Configuration.ToLowerInvariant())</_AppVersionConfiguration>
      <_AppVersionIsRelease>false</_AppVersionIsRelease>
      <_AppVersionIsRelease Condition="$(_AppVersionConfiguration.StartsWith('release'))">true</_AppVersionIsRelease>
      <!-- The exe the counter is read from: the one this build is about to replace. -->
      <_AppVersionPreviousFile Condition="'$(AppVersionPreviousFile)' != ''">$(AppVersionPreviousFile)</_AppVersionPreviousFile>
      <_AppVersionPreviousFile Condition="'$(_AppVersionPreviousFile)' == ''">$(TargetDir)$(TargetName)$(TargetExt)</_AppVersionPreviousFile>
    </PropertyGroup>
    <ComputeAppVersion PreviousFile="$(_AppVersionPreviousFile)" DateFormat="$(AppVersionDateFormat)" TodayOverride="$(AppVersionToday)" Configuration="$(Configuration)" IsReleaseBuild="$(_AppVersionIsRelease)">
      <Output TaskParameter="AppVersion" PropertyName="AppVersion" />
      <Output TaskParameter="AssemblyVersion" PropertyName="AppVersionNormalized" />
      <Output TaskParameter="PreviousVersion" PropertyName="AppVersionPrevious" />
    </ComputeAppVersion>
    <!-- A literal ';' in an item value splits it into two items, and the second one then reaches
         the generated file as a line of nonsense. Escape it as %3B, as the using directive below does. -->
    <ItemGroup>
      <_AppVersionSourceLine Include="// ------------------------------------------------------------------------------" />
      <_AppVersionSourceLine Include="// &lt;auto-generated&gt;" />
      <_AppVersionSourceLine Include="//     Emitted by the SetAppVersion target of AI Helper.csproj." />
      <_AppVersionSourceLine Include="//     It comes from the exe in the output folder%3B change that target, not this file." />
      <_AppVersionSourceLine Include="// &lt;/auto-generated&gt;" />
      <_AppVersionSourceLine Include="// ------------------------------------------------------------------------------" />
      <_AppVersionSourceLine Include="using System.Reflection%3B" />
      <_AppVersionSourceLine Include="[assembly: AssemblyVersion(&quot;$(AppVersionNormalized)&quot;)]" />
      <_AppVersionSourceLine Include="[assembly: AssemblyFileVersion(&quot;$(AppVersionNormalized)&quot;)]" />
      <_AppVersionSourceLine Include="[assembly: AssemblyInformationalVersion(&quot;$(AppVersion)&quot;)]" />
    </ItemGroup>
    <WriteLinesToFile File="$(AppVersionGeneratedFile)" Lines="@(_AppVersionSourceLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(AppVersionGeneratedFile)" />
      <FileWrites Include="$(AppVersionGeneratedFile)" />
    </ItemGroup>
    <PropertyGroup>
      <AppVersionGenerated>true</AppVersionGenerated>
    </PropertyGroup>
    <Message Importance="High" Text="AppVersion: $(AppVersion) written to $(AppVersionGeneratedFile) (previous $(AppVersionPrevious))" />
  </Target>
  <PropertyGroup>
    <PostBuildEvent>call "$(ProjectDir)postbuild.bat" "$(TargetDir)" "$(TargetName)" "$(ProjectDir)" "@(VersionNumber)" $(ConfigurationName)
exit 0</PostBuildEvent>
  </PropertyGroup>
  <PropertyGroup>
    <PostBuildEventDependsOn>
     $(PostBuildEventDependsOn);
     PostBuildMacros;
   </PostBuildEventDependsOn>
  </PropertyGroup>
  <PropertyGroup>
    <!--
       The two tools this application is packaged with are built here rather than by projects of
       their own. Neither has a reference to this application - one is native C++, the other a
       separate program that outlives it - so nothing in the solution has to know about them, but
       both have to exist before this application is packaged, because postbuild.bat copies them
       out of the repository's tools folder into RES\tools of the output. Building them on this
       path is also what makes one build of this application a complete payload.

       A failure here fails the build. Neither tool is optional: without the launch assistant this
       application stays in memory for the length of a whole game session, and without the updater
       a downloaded update can never be applied - which is what it was written to do. Each script
       reports a missing toolchain as the reason.

       The updater is given the MSBuild tools folder the build is already using, so that it does
       not have to find one of its own; build-updater.bat falls back to vswhere when it is empty.
    -->
    <PreBuildEvent>call "$(ProjectDir)..\AIHelperLaunchAssistant\build-assistant.bat" "$(ConfigurationName)" "$(ProjectDir)..\tools\aihelper-launch-assistant"
call "$(ProjectDir)..\AIHelperUpdater\build-updater.bat" "$(ConfigurationName)" "$(MSBuildToolsPath)"</PreBuildEvent>
  </PropertyGroup>
  <Target Name="PostBuildMacros">
    <GetAssemblyIdentity AssemblyFiles="$(TargetPath)">
      <Output TaskParameter="Assemblies" ItemName="Targets" />
    </GetAssemblyIdentity>
    <ItemGroup>
      <VersionNumber Include="@(Targets->'%(Version)')" />
    </ItemGroup>
  </Target>
</Project>